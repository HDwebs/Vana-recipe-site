<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "VANA Recipe Library" }}</title>
  <meta name="description" content="{{ description or 'The VANA Health & Performance recipe library — member-only.' }}">
  <meta name="robots" content="noindex, nofollow">
  <link rel="icon" href="/assets/vana-logo-black.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="wrap">
      <a href="/" class="brand">
        <img src="/assets/vana-logo-colour.png" alt="VANA">
        <span class="brand-sub">Recipe Library</span>
      </a>
      <nav class="header-actions">
        <a href="/">All Recipes</a>
      </nav>
    </div>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap" style="display:flex; justify-content:space-between; width:100%; flex-wrap:wrap; gap:10px;">
      <span>&copy; {{ currentYear }} VANA Health &amp; Performance</span>
      <span>Members only &mdash; not for distribution</span>
    </div>
  </footer>
</body>
</html>
